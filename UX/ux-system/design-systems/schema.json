{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-system.schema.json",
  "title": "DesignSystem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "source",
    "maker",
    "fit",
    "principles",
    "color",
    "typography",
    "spacing",
    "shape",
    "elevation",
    "layout",
    "icons",
    "components",
    "themes",
    "adapt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "maker": { "type": "string", "minLength": 1 },
    "fit": { "type": "string", "minLength": 1 },
    "principles": { "type": "string", "minLength": 1 },
    "color": { "type": "string", "minLength": 1 },
    "typography": { "type": "string", "minLength": 1 },
    "spacing": { "type": "string", "minLength": 1 },
    "shape": { "type": "string", "minLength": 1 },
    "elevation": { "type": "string", "minLength": 1 },
    "layout": { "type": "string", "minLength": 1 },
    "icons": { "type": "string", "minLength": 1 },
    "components": { "type": "string", "minLength": 1 },
    "themes": { "type": "string", "minLength": 1 },
    "adapt": { "type": "string", "minLength": 1 }
  }
}
