{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "font-pairing.schema.json",
  "title": "FontPairing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "fit",
    "heading",
    "body",
    "mono",
    "templates",
    "adapt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "fit": {
      "type": "string",
      "minLength": 1
    },
    "heading": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "mono": {
      "type": "string",
      "minLength": 1
    },
    "templates": {
      "type": "string",
      "minLength": 1
    },
    "adapt": {
      "type": "string",
      "minLength": 1
    }
  }
}
