{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs-template.schema.json",
  "title": "DocsTemplate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "source",
    "fit",
    "layout",
    "typography",
    "fonts",
    "icons",
    "nav",
    "frames",
    "chrome",
    "adapt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "fit": { "type": "string", "minLength": 1 },
    "layout": { "type": "string", "minLength": 1 },
    "typography": { "type": "string", "minLength": 1 },
    "fonts": { "type": "string", "minLength": 1 },
    "icons": { "type": "string", "minLength": 1 },
    "nav": { "type": "string", "minLength": 1 },
    "frames": { "type": "string", "minLength": 1 },
    "chrome": { "type": "string", "minLength": 1 },
    "adapt": { "type": "string", "minLength": 1 }
  }
}
